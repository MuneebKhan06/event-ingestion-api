# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS_RAW=events.raw
KAFKA_TOPIC_EVENTS_DLQ=events.dlq
KAFKA_CONSUMER_GROUP=event-processors
KAFKA_PRODUCER_ACKS=1

# Answer duplicates with 409 before publishing, at the cost of one database
# read per request. Set false to keep the database off the request path;
# duplicates then get 202 and are deduplicated by the consumer instead.
ENABLE_DUPLICATE_PRECHECK=true

# PostgreSQL
POSTGRES_USER=events_user
POSTGRES_PASSWORD=events_password
POSTGRES_DB=events_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL is derived automatically from the POSTGRES_* values above.
# Uncomment to override (e.g. pointing at a managed database instead):
# DATABASE_URL=postgresql+asyncpg://events_user:events_password@localhost:5432/events_db

# Consumer
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_BACKOFF_BASE_SECONDS=1
CONSUMER_METRICS_PORT=9100

# Ingest poller (public API sources: usgs, github, weather)
# github is unauthenticated and rate limited to roughly 60 requests/hour,
# so keep the interval comfortably above one poll per minute if you enable it.
INGEST_API_URL=http://localhost:8000
INGEST_SOURCES=usgs,weather
INGEST_INTERVAL_SECONDS=30
