FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Copied separately so the dependency layer is cached and only rebuilt
# when requirements.txt itself changes, not on every source edit.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app/

# Run as a non-root user: a compromised process in the container should
# not have root inside it.
RUN useradd --create-home --uid 1000 appuser
USER appuser

EXPOSE 8000

# Lives in the image rather than only in docker-compose.yml so the container
# reports health under plain `docker run` too, and so there's one definition
# to keep correct instead of two. Compose inherits this automatically.
# urlopen raises (non-zero exit) on any non-2xx, which is the failure signal.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
